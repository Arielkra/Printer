<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] – מתאו רינאלדי</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;700&family=Heebo:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="masthead">
        <a class="brand" asp-page="/Index">מתאו רינאלדי<small>צייר, פירנצה</small></a>
        <nav>
            <a asp-page="/Gallery">עבודות</a>
            <a asp-page="/About">על הצייר</a>
            <a asp-page="/Contact">יצירת קשר</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="colophon">
        <p>סטודיו מתאו רינאלדי, ויה דיי סרליי 12, פירנצה. פתוח בתיאום מראש.</p>
        <p>© @DateTime.Now.Year, כל הזכויות שמורות</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
